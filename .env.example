# Copy to `.env` at the repo root:  cp .env.example .env
#
# One file, read by both a local run (app/config.py) and `docker compose`, which
# uses it for its own ${VAR} substitutions. `.env` is gitignored; this template is
# not. Process environment always wins over the file.

# Required to run the graph (steps 3-5 and the live eval suite).
ANTHROPIC_API_KEY=

# Optional: Supabase/Postgres pooler URI. Blank uses local SQLite for BOTH
# persistence layers (LangGraph checkpoints + the case store), so a fresh clone
# runs with nothing installed but pip. Setting it switches both to PostgresSaver
# + psycopg; install the two optional packages below and run
# backend/app/db/schema.sql in the Supabase SQL editor first.
DATABASE_URL=

# Optional: LangSmith tracing. Leave blank / false to disable.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Optional overrides — every one of these has a working default (see README).
# ANTHROPIC_MODEL=claude-sonnet-5
# POLICY_RULES_PATH=backend/app/policy/policy_rules.yaml
# SUPPORT_FIXTURES_PATH=backend/eval/cases/fixtures.json
# CHROMA_PATH=backend/.chroma
# KB_MIN_SIMILARITY=0.25
# CHECKPOINT_PATH=backend/.data/checkpoints.sqlite   # LangGraph checkpoints (HITL resume)
# CASE_DB_PATH=backend/.data/cases.sqlite            # cases + the human-review queue

# Only needed when the UI is served from somewhere other than the backend's
# origin. The defaults cover the Vite dev server and the Docker setup.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Postgres path only:
#   pip install "langgraph-checkpoint-postgres>=3,<5" "psycopg[binary]>=3.2"
